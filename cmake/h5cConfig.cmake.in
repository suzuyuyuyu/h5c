@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(H5C_HAVE_PARALLEL @H5C_ENABLE_PARALLEL@)

if(H5C_HAVE_PARALLEL)
    set(HDF5_PREFER_PARALLEL ON)
endif()
find_dependency(HDF5 COMPONENTS C)

if(H5C_HAVE_PARALLEL)
    find_dependency(MPI COMPONENTS C)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/h5cTargets.cmake")

check_required_components(h5c)
